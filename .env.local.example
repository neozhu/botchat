OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_CONVERSATION_SUMMARY_MODEL=gpt-5-mini
# Maximum messages sent to chat, including the current user message.
# Also controls the independent saved-summary batch size.
BOTCHAT_COMPACT_AFTER_USER_MESSAGE_COUNT=6
# Drop oldest messages until their local token estimate is within this budget.
BOTCHAT_COMPACT_AFTER_TOTAL_TOKENS=20000
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TTS_API_KEY=
TTS_API_URL=
TTS_VOICE="af_heart"
ASR_API_KEY=
ASR_API_URL=
